<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flinders_bg"
    android:orientation="vertical">

    <!-- TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/flinders_primary"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/flinders_text_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laba &amp; Tutup Bulan"
                android:textColor="@color/flinders_text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/tvReportPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="November 2026 · Data Otomatis"
                android:textColor="#AACCB8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnChangePeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ganti Periode"
            android:textColor="#AACCB8"
            android:textSize="12sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- LABA BERSIH CARD (Headline sesuai Figma) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/flinders_primary"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Laba Bersih Sementara"
                        android:textColor="#AACCB8"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Otomatis"
                        android:textColor="#AACCB8"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvNetProfit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:textColor="@color/flinders_text_white"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvNetProfitFormula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penjualan − HPP − Pengeluaran tercatat"
                    android:textColor="#AACCB8"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvNetProfitNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Laba bersih dihitung otomatis dari total penjualan kasir dikurangi HPP bahan dan pengeluaran tercatat."
                    android:textColor="#E0EFE6"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- RINGKASAN PENJUALAN DATABASE (OTOMATIS, INPUT MANUAL DIHAPUS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <!-- Header Ringkasan Penjualan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_container_green"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_chart"
                            app:tint="@color/flinders_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pendapatan &amp; Penjualan"
                            android:textColor="@color/flinders_text_title"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diambil otomatis dari sistem database kasir"
                            android:textColor="@color/flinders_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_active"
                        android:text="DB Sync"
                        android:textColor="@color/flinders_success"
                        android:textSize="10sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/flinders_border_light"
                    android:layout_marginBottom="12dp" />

                <!-- Rincian Penjualan dari Database -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Penjualan (Kasir / POS)"
                        android:textColor="@color/flinders_text_body"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDbSalesAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 48.600.000"
                        android:textColor="@color/flinders_success"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HPP (Bahan Penjualan)"
                        android:textColor="@color/flinders_text_body"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDbHppAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="− Rp 18.900.000"
                        android:textColor="@color/flinders_error"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/flinders_border_light"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Laba Kotor (Gross Margin)"
                        android:textColor="@color/flinders_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDbGrossMargin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 29.700.000"
                        android:textColor="@color/flinders_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* Belanja bahan tidak dicatat di pengeluaran manual; biayanya langsung dihitung melalui HPP penjualan."
                    android:textColor="@color/flinders_text_muted"
                    android:textSize="10sp"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- ANALISIS LABA BERSIH PER MENU (HPP & MARGIN) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Laba Bersih &amp; Margin Menu"
                        android:textColor="@color/flinders_text_title"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnManageMenuProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Tambah Menu"
                        android:textColor="@color/flinders_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerMenuProfitRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- PENGELUARAN SECTION (TETAP SEPERTI DI APLIKASI) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <!-- Header Pengeluaran -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_container"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trash"
                            app:tint="@color/flinders_error" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pengeluaran Operasional"
                            android:textColor="@color/flinders_text_title"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sewa, gaji, wifi, utilitas &amp; biaya non-bahan"
                            android:textColor="@color/flinders_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTotalExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="@color/flinders_error"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/flinders_border_light"
                    android:layout_marginBottom="12dp" />

                <!-- Input Pengeluaran Manual -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catat Pengeluaran Baru"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etExpenseName"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Nama pengeluaran (cth: Listrik)"
                        android:textColor="@color/flinders_text_title"
                        android:textColorHint="@color/flinders_text_muted"
                        android:textSize="13sp"
                        android:inputType="text"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etExpenseAmount"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Nominal (Rp)"
                        android:textColor="@color/flinders_text_title"
                        android:textColorHint="@color/flinders_text_muted"
                        android:textSize="13sp"
                        android:inputType="numberDecimal" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnAddExpense"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="+ Tambah Pengeluaran"
                    android:textColor="@color/flinders_error"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/flinders_error_bg" />

                <!-- Daftar baris pengeluaran yang ditambahkan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Pengeluaran Tercatat:"
                    android:textColor="@color/flinders_text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/containerExpenseRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- RINGKASAN KALKULASI LAPORAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ringkasan Perhitungan Laba Bersih"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Penjualan Kasir -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Penjualan (Kasir/POS)"
                        android:textColor="@color/flinders_text_body"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvSummaryIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="@color/flinders_success"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- HPP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HPP Penjualan"
                        android:textColor="@color/flinders_text_body"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvSummaryHpp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="− Rp 0"
                        android:textColor="@color/flinders_error"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Total Pengeluaran -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pengeluaran Operasional"
                        android:textColor="@color/flinders_text_body"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvSummaryExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="@color/flinders_error"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/flinders_border_light"
                    android:layout_marginBottom="10dp" />

                <!-- Laba Bersih -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Laba Bersih Sementara"
                        android:textColor="@color/flinders_text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvSummaryNet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="@color/flinders_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- TOMBOL KONFIRMASI LAPORAN -->
            <Button
                android:id="@+id/btnConfirmReport"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Konfirmasi &amp; Simpan Laporan"
                android:textColor="@color/flinders_text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/flinders_primary"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnCloseMonth"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Tutup Buku Bulan Ini"
                android:textColor="@color/flinders_primary"
                android:textSize="14sp"
                android:backgroundTint="@color/flinders_primary_alpha10"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
