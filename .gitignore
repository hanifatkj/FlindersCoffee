# ==========================================
# Flinders Coffee Management System .gitignore
# ==========================================

# Built application files
*.apk
*.aar
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
*/build/

# Gradle files
.gradle/
buildOutput/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Android Studio
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio / IntelliJ IDEA files
.idea/
*.iml
*.ipr
*.iws

# Keystore files
*.jks
*.keystore

# Google Services (Firebase credentials)
# google-services.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Kotlin
.kotlin/
