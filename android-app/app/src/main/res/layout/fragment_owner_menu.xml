<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flinders_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="FLINDERS COFFEE / OWNER"
                    android:textColor="#8C6E52"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kelola menu"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Harga jual dan HPP · Hanya owner"
                    android:textColor="@color/flinders_text_muted"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btnMenuSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />

        </LinearLayout>

        <!-- TOP ACTIONS: + Menu Baru & Impor Spreadsheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewMenu"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/flinders_primary"
                android:text="+ Menu baru"
                android:textAllCaps="false"
                android:textColor="@color/flinders_text_white"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportSpreadsheet"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.2"
                android:text="Impor spreadsheet"
                android:textAllCaps="false"
                android:textColor="@color/flinders_text_title"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/flinders_border" />

        </LinearLayout>

        <!-- SEARCH INPUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearchMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Cari menu…"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/flinders_text_title"
                android:textColorHint="@color/flinders_text_muted"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- CATEGORY FILTERS CHIPS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCategoryAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_primary"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Semua"
                    android:textColor="@color/flinders_text_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCategoryKopi"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Coffee"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipCategoryFlavoured"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Flavoured Coffee"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipCategorySignature"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Signature"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipCategoryAmericano"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Americano Series"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipCategoryNonKopi"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Non Coffee"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipCategoryFrappe"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Frappe"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipCategoryTea"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Tea"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipCategoryMakanan"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Meal &amp; Snack"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- STATUS FILTERS CHIPS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipStatusActive"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_primary"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Aktif"
                android:textColor="@color/flinders_text_white"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipStatusInactive"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill_unselected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Nonaktif"
                android:textColor="@color/flinders_text_title"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- MENU CARDS CONTAINER (Peninjauan menu kustom TIDAK ADA sesuai instruksi) -->
        <LinearLayout
            android:id="@+id/containerMenuList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- BOTTOM NOTICE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_info_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="Menu dinonaktifkan, bukan dihapus. Riwayat transaksi lama tetap utuh."
                android:textColor="#3D6647"
                android:textSize="12.5sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
