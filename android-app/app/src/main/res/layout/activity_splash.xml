<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flinders_primary">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo Icon -->
        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_flinders_logo"
            android:contentDescription="Flinders Coffee Logo" />

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvSplashBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="flinders"
            android:textColor="@color/flinders_text_white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="serif" />

        <!-- Sub Brand -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C O F F E E"
            android:textColor="#AACCB8"
            android:textSize="13sp"
            android:letterSpacing="0.3"
            android:layout_marginTop="2dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kopi Pilihan · Ruang Nyaman"
            android:textColor="#E0EFE6"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Version & Loading indicator at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="#AACCB8"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textColor="#88B89E"
            android:textSize="11sp" />

    </LinearLayout>

</RelativeLayout>
