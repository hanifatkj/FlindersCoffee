<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flinders_bg"
    android:orientation="vertical">

    <!-- TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/flinders_primary"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/flinders_text_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Konfirmasi Check-In"
            android:textColor="@color/flinders_text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detail Reservasi"
                    android:textColor="@color/flinders_text_muted"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvBookingCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Andi Pratama"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBookingTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meja 3 · 4 Kursi"
                    android:textColor="@color/flinders_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvBookingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hari ini, 14:00 - 16:00 WITA"
                    android:textColor="@color/flinders_text_muted"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- PERINGATAN KASIR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_green"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/flinders_primary"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pastikan pelanggan sudah hadir di kafe sebelum menekan tombol konfirmasi kehadiran."
                    android:textColor="@color/flinders_primary"
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnConfirmCheckIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Konfirmasi Kehadiran"
                android:textColor="@color/flinders_text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/flinders_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCancelBooking"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Batalkan Reservasi"
                android:textColor="@color/flinders_error"
                android:textSize="14sp"
                android:backgroundTint="@color/flinders_error_bg" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
