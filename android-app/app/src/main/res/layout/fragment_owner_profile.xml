<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flinders_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/flinders_primary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:orientation="vertical">

            <!-- Avatar circle + name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@color/flinders_primary_light"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="F"
                        android:textColor="@color/flinders_text_white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOwnerProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pemilik Flinders"
                        android:textColor="@color/flinders_text_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Owner"
                        android:textColor="#AACCB8"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvOwnerEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="owner@flinders.co"
                        android:textColor="#AACCB8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- MENU OPTIONS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manajemen"
            android:textColor="@color/flinders_text_muted"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <!-- Konfirmasi Stamp -->
        <LinearLayout
            android:id="@+id/menuConfirmStamp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/flinders_card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container_green"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_qr_code"
                    app:tint="@color/flinders_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Konfirmasi Stamp"
                android:textColor="@color/flinders_text_body"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_back"
                android:rotation="180"
                app:tint="@color/flinders_text_muted" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/flinders_border_light" />

        <!-- Riwayat Reward -->
        <LinearLayout
            android:id="@+id/menuRewardHistory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/flinders_card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gift"
                    app:tint="@color/flinders_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Riwayat Reward"
                android:textColor="@color/flinders_text_body"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_back"
                android:rotation="180"
                app:tint="@color/flinders_text_muted" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/flinders_border_light" />

        <!-- Tambah Menu -->
        <LinearLayout
            android:id="@+id/menuAddItem"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/flinders_card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/flinders_text_body" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tambah Item Menu"
                android:textColor="@color/flinders_text_body"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_back"
                android:rotation="180"
                app:tint="@color/flinders_text_muted" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/flinders_border_light" />

        <!-- Laporan Keuangan -->
        <LinearLayout
            android:id="@+id/menuReport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/flinders_card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chart"
                    app:tint="@color/flinders_text_body" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Laporan Keuangan"
                android:textColor="@color/flinders_text_body"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_back"
                android:rotation="180"
                app:tint="@color/flinders_text_muted" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/flinders_bg" />

        <!-- AKUN Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Akun"
            android:textColor="@color/flinders_text_muted"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- Edit Profil -->
        <LinearLayout
            android:id="@+id/menuEditProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/flinders_card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/flinders_text_body" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit Profil"
                android:textColor="@color/flinders_text_body"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_back"
                android:rotation="180"
                app:tint="@color/flinders_text_muted" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/flinders_border_light" />

        <!-- Tentang Aplikasi -->
        <LinearLayout
            android:id="@+id/menuAboutApp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/flinders_card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container_green"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info"
                    app:tint="@color/flinders_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tentang Aplikasi"
                android:textColor="@color/flinders_text_body"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_back"
                android:rotation="180"
                app:tint="@color/flinders_text_muted" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/flinders_border_light" />

        <!-- Keluar -->
        <LinearLayout
            android:id="@+id/menuOwnerLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/flinders_card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_container"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/flinders_error" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Keluar"
                android:textColor="@color/flinders_error"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
