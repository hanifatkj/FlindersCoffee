<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flinders_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="40dp">

        <!-- HEADER: BACK TO KELOLA MENU -->
        <LinearLayout
            android:id="@+id/btnBackHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_back"
                app:tint="@color/flinders_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kelola menu"
                android:textColor="@color/flinders_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLINDERS COFFEE / OWNER"
            android:textColor="@color/flinders_warning"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp" />

        <!-- TITLE ROW WITH SECURITY SHIELD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tambah menu baru"
                android:textColor="@color/flinders_text_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/flinders_primary" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entri katalog baru · Hanya owner"
            android:textColor="@color/flinders_text_muted"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp" />

        <!-- CARD DETAIL MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detail menu"
                android:textColor="@color/flinders_text_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <!-- UPLOAD FOTO PLACEHOLDER (DASHED BORDER) -->
            <LinearLayout
                android:id="@+id/boxUploadPhoto"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_photo_dashed"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/flinders_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tambah foto (opsional)"
                    android:textColor="@color/flinders_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JPG / PNG · Maks. 5 MB"
                    android:textColor="@color/flinders_text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- NAMA MENU -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama menu *"
                android:textColor="@color/flinders_text_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etMenuName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Vanilla Latte"
                android:textColor="@color/flinders_text_title"
                android:textColorHint="@color/flinders_text_muted"
                android:textSize="14sp"
                android:inputType="textCapWords"
                android:layout_marginBottom="14dp" />

            <!-- KATEGORI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kategori *"
                android:textColor="@color/flinders_text_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp" />

            <!-- HARGA JUAL & HPP/PORSI (SIDE BY SIDE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- KOLOM KIRI: HARGA JUAL -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harga jual *"
                        android:textColor="@color/flinders_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etMenuPrice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Rp32.000"
                        android:textColor="@color/flinders_text_title"
                        android:textColorHint="@color/flinders_text_muted"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:inputType="number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wajib diisi, angka &gt; 0."
                        android:textColor="@color/flinders_text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- KOLOM KANAN: HPP / PORSI -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HPP / porsi *"
                        android:textColor="@color/flinders_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etMenuHpp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Rp12.000"
                        android:textColor="@color/flinders_text_title"
                        android:textColorHint="@color/flinders_text_muted"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:inputType="number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wajib diisi, angka &gt; 0."
                        android:textColor="@color/flinders_text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- REALTIME ESTIMASI LABA BERSIH PER PORSI -->
            <LinearLayout
                android:id="@+id/boxMarginPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvMarginPreviewText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Estimasi Laba: Masukkan harga jual &amp; HPP"
                    android:textColor="@color/flinders_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- STATUS MENU: TOGGLE SWITCH -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/flinders_border_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status menu · Aktif"
                        android:textColor="@color/flinders_text_title"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tampil di kasir mulai tanggal efektif."
                        android:textColor="@color/flinders_text_muted"
                        android:textSize="11.5sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMenuStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/flinders_primary"
                    app:trackTint="@color/flinders_border" />

            </LinearLayout>

            <!-- BERLAKU MULAI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berlaku mulai *"
                android:textColor="@color/flinders_text_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/tvEffectiveDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="14 Nov 2026 · 12.00 WITA"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13.5sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/flinders_primary" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dijadwalkan aktif saat disimpan."
                android:textColor="@color/flinders_text_muted"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- INFO CARD 1: BERLAKU UNTUK PENJUALAN BERIKUTNYA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_card"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️"
                android:textSize="16sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berlaku untuk penjualan berikutnya"
                    android:textColor="@color/flinders_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu ini tidak mengganti menu yang sudah ada. Harga dan HPP tersimpan sebagai snapshot pesanan; transaksi lama tetap utuh."
                    android:textColor="@color/flinders_text_body"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- INFO CARD 2: BIAYA BAHAN DIHITUNG MELALUI HPP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_card"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️"
                android:textSize="16sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biaya bahan dihitung melalui HPP pada penjualan Dibayar. Belanja bahan/stok bukan pengeluaran; tidak dihitung dua kali."
                    android:textColor="@color/flinders_text_body"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- BUTTON 1: BUAT & SIMPAN MENU -->
        <Button
            android:id="@+id/btnSaveMenu"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Buat &amp; simpan menu"
            android:textColor="@color/flinders_text_white"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:backgroundTint="@color/flinders_primary"
            android:layout_marginBottom="10dp" />

        <!-- BUTTON 2: BATAL, KEMBALI KE MENU -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Batal, kembali ke menu"
            android:textColor="@color/flinders_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/flinders_card_bg"
            app:strokeColor="@color/flinders_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="18dp" />

        <!-- FOOTER AUDIT NOTE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pembuatan dicatat atas nama Owner. Menu dapat dinonaktifkan, bukan dihapus, untuk menjaga riwayat transaksi."
            android:textColor="@color/flinders_text_muted"
            android:textSize="11sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</ScrollView>
