<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flinders_bg">

    <FrameLayout
        android:id="@+id/ownerFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/ownerBottomNav"
        style="@style/Widget.Flinders.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/flinders_card_bg"
        app:elevation="12dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/nav_item_selector"
        app:itemTextColor="@color/nav_item_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/owner_bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
