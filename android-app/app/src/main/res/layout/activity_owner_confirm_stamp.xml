<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flinders_bg"
    android:orientation="vertical">

    <!-- TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/flinders_primary"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/flinders_text_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan Hadiah &amp; Member"
                android:textColor="@color/flinders_text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owner Scanner · Kamera Aktif"
                android:textColor="#AACCB8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnToggleFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_qr_code"
            app:tint="@color/flinders_text_white" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- BANNER INFO OWNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_green"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/flinders_primary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hanya Owner yang hadir berhak menukar hadiah member. Penukaran akan mereset stamp dan mengunci barcode hadiah selama 24 jam."
                    android:textColor="@color/flinders_primary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- CAMERA SCANNER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCAN KODE MEMBER / HADIAH"
                    android:textColor="@color/flinders_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp" />

                <!-- LIVE CAMERA VIEWFINDER -->
                <FrameLayout
                    android:id="@+id/frameScannerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="#1B382B">

                    <com.journeyapps.barcodescanner.DecoratedBarcodeView
                        android:id="@+id/barcodeScannerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Overlay petunjuk jika kamera belum aktif/permission -->
                    <LinearLayout
                        android:id="@+id/layoutCameraPermissionPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:visibility="gone"
                        android:background="#20332B">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_qr_code"
                            app:tint="#AACCB8"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Izin Kamera Diperlukan"
                            android:textColor="@color/flinders_text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Izinkan akses kamera untuk memindai QR code pelanggan secara langsung."
                            android:textColor="#AACCB8"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                        <Button
                            android:id="@+id/btnRequestCameraPermission"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Berikan Izin Kamera"
                            android:textSize="12sp"
                            android:textColor="@color/flinders_primary"
                            android:backgroundTint="@color/flinders_text_white"
                            android:layout_marginTop="10dp" />

                    </LinearLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/tvScanInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arahkan kamera ke layar QR Code member di aplikasi Flinders."
                    android:textColor="@color/flinders_text_muted"
                    android:textSize="11sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- MANUAL INPUT FALLBACK (SESUAI FIGMA SCREEN 11) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kamera bermasalah atau offline?"
                    android:textColor="@color/flinders_text_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cari manual dengan kode member (misal: FLN-482913 atau FLD-001)"
                    android:textColor="@color/flinders_text_muted"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCustomerId"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="Cth: FLN-482913"
                        android:inputType="textCapCharacters"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/flinders_text_title"
                        android:textColorHint="@color/flinders_text_muted"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnSearchCustomer"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/flinders_primary"
                        android:text="Cari Member"
                        android:textColor="@color/flinders_text_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- HASIL / PRATINJAU KARTU MEMBER (DYNAMIC RESULT) -->
            <LinearLayout
                android:id="@+id/cardCustomerResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_marginBottom="14dp">

                <!-- Header Result & Badge Stamp -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvResultTag"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PRATINJAU MEMBER"
                        android:textColor="@color/flinders_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentStamps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_active"
                        android:text="10 / 10"
                        android:textColor="@color/flinders_success"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                </LinearLayout>

                <!-- Profile Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:id="@+id/avatarContainer"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_container_green"
                        android:layout_marginEnd="12dp">
                        <TextView
                            android:id="@+id/tvCustomerAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="R"
                            android:textColor="@color/flinders_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCustomerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rina"
                            android:textColor="@color/flinders_text_title"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCustomerPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FLN-482913 · 0812-3456-7890"
                            android:textColor="@color/flinders_text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/flinders_border_light"
                    android:layout_marginBottom="10dp" />

                <!-- Detail Status Hadiah / Info -->
                <LinearLayout
                    android:id="@+id/layoutRewardEligible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hadiah Tersedia"
                            android:textColor="@color/flinders_text_body"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 Minuman Gratis"
                            android:textColor="@color/flinders_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRewardNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stamp sudah 10/10. Pastikan member berada di kafe. Setelah dikonfirmasi, stamp akan direset ke 0 dan penukaran barcode dikunci selama 24 jam."
                        android:textColor="@color/flinders_text_muted"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnConfirmRedeem"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/flinders_primary"
                        android:text="Konfirmasi Tukar Hadiah"
                        android:textColor="@color/flinders_text_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Status jika stamp belum 10/10 -->
                <LinearLayout
                    android:id="@+id/layoutStampIncomplete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvIncompleteNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Member belum berhak menukar hadiah (butuh 3 stamp lagi). Anda dapat menambahkan 1 stamp harian jika pesanan sudah dibayar."
                        android:textColor="@color/flinders_text_muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnAddSingleStamp"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:backgroundTint="@color/flinders_primary_alpha10"
                        android:text="+ Berikan 1 Stamp Harian"
                        android:textColor="@color/flinders_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Status jika barcode terkunci 24 jam -->
                <LinearLayout
                    android:id="@+id/layoutLocked24h"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Barcode Penukaran Terkunci 24 Jam"
                        android:textColor="@color/flinders_error"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvLockedNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Member baru saja menukar hadiah. Penukaran hadiah berikutnya baru bisa dilakukan setelah masa tunggu 24 jam selesai."
                        android:textColor="@color/flinders_text_muted"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <!-- BUKTI PENUKARAN BERHASIL (#RDM-xxx) -->
                <LinearLayout
                    android:id="@+id/layoutRedemptionSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_banner_green"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Penukaran Hadiah Berhasil!"
                            android:textColor="@color/flinders_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRedemptionCodeProof"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bukti Penukaran: #RDM-008"
                            android:textColor="@color/flinders_text_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stamp direset 10 → 0 · Barcode penukaran terkunci 24 jam"
                            android:textColor="@color/flinders_text_muted"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnResetToScan"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/flinders_primary"
                        android:text="Scan Member Lain"
                        android:textColor="@color/flinders_text_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
